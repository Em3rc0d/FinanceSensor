      "humanAccess": "USER_ONLY",
      "logging": "FORBIDDEN"
    },
    {
      "id": "RECOVERY-PUBLIC-KEY",
      "name": "Tenant Recovery Public Key metadata",
      "sensitivity": "MEDIUM",
