  "discoveryCandidatePolicy": {
    "states": ["REJECTED", "WEAK", "PROBABLE", "STRONG", "CONFLICT"],
    "downloadState": "STRONG",
    "strongMinimumScore": 85,
    "probableMinimumScore": 65,
    "maximumAttachmentBytes": 20971520,
    "requiredSignals": [
      "PROFILE_MATCH_UNIQUE",
      "KNOWN_SENDER",
      "PDF_DESCRIPTOR",
      "STATEMENT_MARKER"
    ],
    "hardStops": [
      "PROFILE_MATCH_CONFLICT",
      "UNKNOWN_SENDER",
      "NON_PDF_DESCRIPTOR",
      "EMPTY_ATTACHMENT",
      "ATTACHMENT_TOO_LARGE",
      "AUTHORITY_REVOKED"
    ],
    "durableRawMetadata": false
  },
  "passwordPolicy": {
    "persistence": false,
    "logging": false,
    "analytics": false,
    "cloud": false,
    "autofillPersistence": false,
    "sessionReuseRequiresExplicitChoice": true,
    "crossInstitutionReuse": false,
    "deterministicDartZeroizationClaimed": false
  },
  "rawBoundary": {
    "durablePdfBytes": false,
    "durableDecryptedText": false,
    "durableOcrPages": false,
    "durableLayoutGeometry": false,
    "durableRawRows": false,
    "activePdfExecution": false,
    "genericParserFallback": false
  },
  "vaultPolicy": {
    "databaseFamily": "SQLCIPHER_4_X",
    "dekBits": 256,
    "plaintextFallback": false,
    "platformWrappedDek": true,
    "atomicDerivedBatchAndTerminalSourceState": true,
    "physicalInspectionTargets": [
      "DATABASE",
      "WAL",
      "SHM_OR_JOURNAL",
      "TEMP",
      "MIGRATION_BACKUP",
      "OS_BACKUP",
      "LOGS",
      "CRASH_OUTPUT"
    ]
  },
  "reconciliationPolicy": {
    "version": "A2_RECONCILIATION_V1",
    "outcomes": ["CONFIRMED", "PROPOSED", "REVIEW", "REJECTED", "CONFLICT"],
    "hardVetoes": [
      "CURRENCY_MISMATCH",
      "ECONOMIC_SEMANTICS_INCOMPATIBLE",
      "TENANT_MISMATCH",
      "ALREADY_LINKED_CONFLICT",
      "SOURCE_CHANNEL_NOT_INDEPENDENT"
    ],
    "features": {
      "amount": 30,
      "timeDistance": 15,
      "institution": 10,
      "accountOrInstrument": 15,
      "merchantOrCounterparty": 10,
      "externalReference": 15,
      "movementCompatibility": 5
    },
    "automaticConfirmation": {
      "minimumScore": 85,
      "minimumMarginOverSecondCandidate": 15,
      "requiresUniqueCandidate": true,
      "requiresIndependentChannels": true,
      "requiresAmountAndCurrency": true,
      "requiresStableAnchor": [
        "EXACT_EXTERNAL_REFERENCE",
        "CONFIRMED_ACCOUNT_OR_INSTRUMENT_PLUS_STRONG_MERCHANT"
      ],
      "amountOnlyAllowed": false
    }
  },
  "accountMappingPolicy": {
    "states": [
      "UNMAPPED",
      "PROBABLE",
      "USER_CONFIRMED",
      "SYSTEM_CONFIRMED_BY_STABLE_EVIDENCE"
    ],
    "bankPlusCurrencySufficient": false,
    "stableEvidencePeriodsForAutomaticConfirmation": 2
  },
  "monthlyCoveragePolicy": {
    "states": [
      "OPEN_LIVE",
      "WAITING_FOR_STATEMENTS",
      "IMPORTING",
      "RECONCILING",
      "REVIEW_REQUIRED",
      "RECONCILED",
      "REOPENED"
    ],
    "globalUnqualifiedPercentageAllowed": false,
    "reconciledRequiresAllIncludedExpectedSources": true,
    "reconciledRequiresZeroBlockingConflicts": true,
    "userExcludedSourcesRemainVisible": true
  },
  "sensorPolicy": {
    "deterministicOnly": true,
    "llmEnabled": false,
    "automatedFinancialAdvice": false,
    "truthStates": ["OBSERVED", "POSTED", "RECONCILED", "PARTIAL", "UNKNOWN"],
    "genericEvidencePercentageAllowed": false
  },
